# Kopiere diese Datei nach .env und passe die Werte an.
# .env selbst wird nicht versioniert.

DJANGO_SECRET_KEY=bitte-einen-eigenen-zufaelligen-schluessel-eintragen
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- OpenAI ---
# Den echten Schluessel NIE hier eintragen, sondern nur in der lokalen .env.
# Bleibt der Wert leer, laeuft die Anwendung automatisch im Mock-Modus weiter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Erzwingt den Mock-Modus auch dann, wenn ein Schluessel gesetzt ist.
AI_MOCK_MODE=False
